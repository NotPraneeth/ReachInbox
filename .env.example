# =============================================================================
# Production environment template for docker-compose.yml
# Copy to `.env`, fill in real values, then `docker compose up -d --build`.
# =============================================================================

# Public site name served by Caddy (used for HTTPS + Google OAuth redirects).
# Use a real domain, e.g. reachinbox.example.com, or a free wildcard like
#   123.45.67.89.sslip.io   (point at your VM's public IP)
DOMAIN=reachinbox.example.com

# Backend / worker hostname the frontend proxies to (internal compose network).
# Leave as default unless you change the api service name.
WEB_BACKEND_URL=http://api:4000

# --- Google OAuth (required) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public return URL — must equal the "Authorized redirect URI" you added in
# Google Cloud Console (the FRONTEND origin, not the backend):
#   https://<DOMAIN>/auth/google/callback
GOOGLE_CALLBACK_URL=https://reachinbox.example.com/auth/google/callback

# --- Data stores (instances on the compose network) -----------------------
# Leave these defaults unless you point at a managed host (Neon/Upstash).
DATABASE_URL=postgresql://reachinbox:reachinbox@postgres:5432/reachinbox
REDIS_URL=redis://redis:6379

# Frontend origin (what CORS allows). Defaults to https://<DOMAIN>.
FRONTEND_URL=https://reachinbox.example.com

# Change to a long random string (signs session cookies).
SESSION_SECRET=change-me-production

# --- Scheduling / throughput ----------------------------------------------
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=5000
RATE_LIMIT_MODE=per_sender
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=150
MAX_RECONCILE_ATTEMPTS=3

# --- Ethereal (fake SMTP sink) --------------------------------------------
ETHEREAL_AUTO_CREATE=true
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587