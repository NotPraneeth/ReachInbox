{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox email scheduler backend (Express + BullMQ + Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:build": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "simulate-burst": "tsx scripts/simulate-burst.ts",
    "test-delayed-job": "tsx scripts/test-delayed-job.ts",
    "test-rate-limit": "tsx scripts/test-rate-limit.ts",
    "test-reconcile": "tsx scripts/test-reconcile.ts",
    "dev-session": "tsx scripts/dev-session.ts",
    "cancel-all-scheduled": "tsx scripts/cancel-all-scheduled.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.0",
    "connect-redis": "^7.1.1",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "papaparse": "^5.4.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.15",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
